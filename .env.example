# Bambino environment template.
# Copy to .env.local (development) or .env.test (tests). Never commit real values.
# Every value below is a placeholder. Startup validation (Phase 3) will refuse to
# boot in production when a required value is missing or still a placeholder.

NODE_ENV=development
MARKET_CODE=RW

# --- Database -------------------------------------------------------------
# A PostgreSQL server, or pglite:<directory> for an in-process database in local development.
# The Docker PostgreSQL from docker-compose.yml listens on 5433 with these development credentials:
# DATABASE_URL=postgresql://bambino:bambino_dev_password@127.0.0.1:5433/bambino_dev
DATABASE_URL=postgresql://bambino:CHANGE_ME@localhost:5432/bambino_dev
# DATABASE_URL=pglite:./.data/dev

# --- API ------------------------------------------------------------------
API_PORT=4000
GRAPHQL_URL=http://localhost:4000/graphql
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# memory (one API instance) or postgres (several instances share limits).
RATE_LIMITER=memory
LOG_LEVEL=info

# --- Auth -----------------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Payments (server only; never prefix with NEXT_PUBLIC_ / EXPO_PUBLIC_) --
# Comma-separated: "mock" (refused in production) and "mtn_momo". Airtel Money is NOT YET INTEGRATED.
PAYMENT_PROVIDERS_ENABLED=mock
# MTN MoMo (https://momodeveloper.mtn.com). The sandbox host and the "sandbox" target accept EUR only; production
# uses the live host and target name MTN assigns, and RWF. Secrets: set them with `wrangler secret put`, not here.
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# MTN_MOMO_CURRENCY=EUR
# MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
# MTN_MOMO_COLLECTION_API_USER=
# MTN_MOMO_COLLECTION_API_KEY=
# Refunds only:
# MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
# MTN_MOMO_DISBURSEMENT_API_USER=
# MTN_MOMO_DISBURSEMENT_API_KEY=
MOCK_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_development_only
PAYMENT_EXPIRY_MINUTES=10
RECONCILE_INTERVAL_SECONDS=60
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_WEBHOOK_SECRET=
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=

# --- Email ----------------------------------------------------------------
# console (logs only, development) | resend (needs RESEND_API_KEY and a verified sending domain)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Bambino <no-reply@example.com>

# --- Push notifications (P1) ------------------------------------------------
FIREBASE_CONFIG=

# --- Object storage ---------------------------------------------------------
# local: no uploads (image upload operations answer NOT_IMPLEMENTED)
# s3: any S3-compatible service. For the Docker RustFS from docker-compose.yml:
#   STORAGE_ENDPOINT=http://127.0.0.1:9000, STORAGE_ACCESS_KEY_ID=bambino,
#   STORAGE_SECRET_ACCESS_KEY=bambino_dev_password, then run: pnpm --filter @bambino/api storage:init
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bambino-media
# Optional second bucket that is never public, for data exports. Required on Cloudflare R2 (no per-prefix public read).
STORAGE_PRIVATE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/bambino-media
# --- Development seed accounts (pnpm db:seed; ignored in production) --------
# admin@seed.test (SUPER_ADMIN) and parent@seed.test are created only when set.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Error tracking (optional). Reports go to Sentry only when set; personal data is scrubbed first.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
