    "@bambino/validation": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
