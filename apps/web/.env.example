# GraphQL endpoint the server-rendered pages read from.
API_URL=http://127.0.0.1:4000/graphql

# GraphQL endpoint the browser calls directly (cookies are httpOnly and same-site).
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
# Where product photos are served from: the same value as the API's STORAGE_PUBLIC_BASE_URL. Read at request
# time and allowed in the images part of the Content-Security-Policy.
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/bambino-media
# Shows the mock test wallets at checkout. Never enable in production.
NEXT_PUBLIC_MOCK_PAYMENTS=true

# Public URL used in the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true at launch to allow search engines.
SITE_INDEXING=false
