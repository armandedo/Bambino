# GraphQL endpoint the server-rendered pages read from.
API_URL=http://127.0.0.1:4000/graphql

# GraphQL endpoint the browser calls directly (cookies are httpOnly and same-site). https required for launch.
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
# Where product photos are served from: the same value as the API's STORAGE_PUBLIC_BASE_URL. Read at request
# time and allowed in the images part of the Content-Security-Policy.
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/bambino-media
# Shows the mock test wallets at checkout. A production build refuses true unless it is a preview (below).
NEXT_PUBLIC_MOCK_PAYMENTS=true
# Marks a preview build: a banner on every page says so. The only way `next build` accepts mock payments or http
# URLs (useful for local production builds). Leave unset or false for launch.
NEXT_PUBLIC_PREVIEW_BANNER=true

# Public URL used in the sitemap and robots.txt. A production build requires https unless it is a preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true at launch to allow search engines.
SITE_INDEXING=false

# Error tracking (optional): server errors (SENTRY_DSN) and browser errors (NEXT_PUBLIC_SENTRY_DSN, also allowed by the CSP).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Mobile-money brands that are really live, comma separated: "MTN MoMo,Airtel Money". The home page and the plans
# FAQ name only these. Leave empty until a provider is integrated (cash on delivery is always mentioned).
PAYMENT_METHODS=
