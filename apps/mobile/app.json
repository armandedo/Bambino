{
  "expo": {
    "name": "Bambino",
    "slug": "bambino",
    "scheme": "bambino",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "rw.bambino.app"
    },
    "android": {
      "package": "rw.bambino.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
